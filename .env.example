# Core application
NODE_ENV=development
APP_NAME=edvoura-api
APP_PORT=4000
APP_HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Supabase public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Supabase server
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth and security
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
API_REQUEST_TIMEOUT_MS=10000
API_RATE_LIMIT_MAX=120

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_SERVICE_NAME=edvoura-api
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@edvoura.com

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PORTAL_CONFIG_ID=

# Live classes
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=

# Support and operations
SUPPORT_EMAIL=support@edvoura.com
DEFAULT_TIMEZONE=Africa/Lagos
